#!/usr/bin/env bash
#MISE description="Rebuild and restart only the window; the server and every pane keep running. Refuses when the server's own code changed, which would replace it"
#MISE depends=["build-fast"]
# [USAGE] flag "--server" help="Go ahead even though the server's code changed: the server is replaced and every pane's processes end (agent tabs resume when opened)"
set -euo pipefail
. "$MISE_PROJECT_ROOT/mise-tasks/.server-stamp.sh"
running=$(server_pid || true)
if [ -n "$running" ] && [ "$(cat "$stamp" 2>/dev/null || true)" != "$running $(server_code)" ] \
  && [ "${usage_server:-false}" != true ]; then
  echo "reload: server $running was not started from this server code, so a new window would replace it and end every pane's processes." >&2
  echo "reload: rerun with --server to do it anyway." >&2
  exit 1
fi
# A window from another checkout (or the upstream app) owns the server; one
# from here would replace it and end every pane's processes.
others=$(pgrep -fl 'tty7-app$' | awk '{print $2}' | grep -v "^$MISE_PROJECT_ROOT/target/fast/tty7-app$" || true)
if [ -n "$others" ]; then
  echo "reload: tty7 is running from $others; reload from that checkout instead." >&2
  exit 1
fi
# Only the window: its path ends in tty7-app, the server's in its flags.
for pid in $(pgrep -f "$MISE_PROJECT_ROOT/target/fast/tty7-app$" || true); do
  kill "$pid"
  for _ in 1 2 3 4 5; do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
done
exec "$MISE_PROJECT_ROOT/mise-tasks/launch"
