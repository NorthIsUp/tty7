#!/usr/bin/env bash
#MISE description="Rebuild, reinstall and restart only the window; the server and every pane keep running. Refuses when the server's own code changed, which would replace it"
# [USAGE] flag "--server" help="Go ahead even though the server's code changed: the server is replaced and every pane's processes end (agent tabs resume when opened)"
set -euo pipefail
. "$MISE_PROJECT_ROOT/mise-tasks/.server-stamp.sh"
running=$(server_pid || true)
if [ -n "$running" ] && [ "$(cat "$stamp" 2>/dev/null || true)" != "$running $(server_code)" ] \
  && [ "${usage_server:-false}" != true ]; then
  echo "reload: server $running was not started from this server code, so a new window would replace it and end every pane's processes." >&2
  echo "reload: rerun with --server to do it anyway." >&2
  exit 1
fi
# Any window but the installed bundle's (an old target/ build, the upstream
# app) shares the server, and a bundle window replacing it replaces the server
# too — the same cost --server accepts.
others=$(pgrep -fl 'tty7-app$' | awk '{print $2}' | grep -v "^$app/Contents/MacOS/tty7-app$" || true)
if [ -n "$others" ] && [ "${usage_server:-false}" != true ]; then
  echo "reload: tty7 is running from $others, not $app; switching replaces the server." >&2
  echo "reload: rerun with --server to do it anyway." >&2
  exit 1
fi
"$MISE_PROJECT_ROOT/mise-tasks/install-app"
# Only the window: its path ends in tty7-app, the server's in its flags.
for pid in $(pgrep -f "$app/Contents/MacOS/tty7-app$" || true); do
  kill "$pid"
  for _ in 1 2 3 4 5; do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
done
exec "$MISE_PROJECT_ROOT/mise-tasks/launch"
