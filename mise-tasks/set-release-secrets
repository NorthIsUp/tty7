#!/usr/bin/env bash
#MISE description="Human-run: push the Developer ID cert and notarization key to NorthIsUp/tty7's Actions secrets, for release.yml"
# Agents can't run this (auto mode blocks `gh secret set`), and shouldn't: it is
# where the private keys leave the machine. Same team material tsmux and
# clip.md ship with.
set -euo pipefail
repo="${1:-NorthIsUp/tty7}"
team_dir="${TEAM_DIR:-$HOME/.appstoreconnect/clipmd}"
: "${ASC_KEY_ID:=238ATU74S4}"
: "${ASC_ISSUER_ID:=98c62465-9650-49ec-afe4-23318e5c1ae1}"
key="$HOME/.appstoreconnect/private_keys/AuthKey_$ASC_KEY_ID.p8"
for f in "$key" "$team_dir/devid.p12" "$team_dir/p12.pass"; do
  [ -f "$f" ] || { echo "missing $f" >&2; exit 1; }
done
base64 -i "$team_dir/devid.p12" | gh secret set APPLE_CERTIFICATE --repo "$repo"
gh secret set APPLE_CERTIFICATE_PASSWORD --repo "$repo" < "$team_dir/p12.pass"
gh secret set APPLE_SIGNING_IDENTITY --repo "$repo" --body "Developer ID Application: Adam Hitchcock (4BJBDQVY6M)"
openssl rand -hex 24 | gh secret set KEYCHAIN_PASSWORD --repo "$repo"
gh secret set ASC_KEY_P8 --repo "$repo" < "$key"
gh variable set ASC_KEY_ID --repo "$repo" --body "$ASC_KEY_ID"
gh variable set ASC_ISSUER_ID --repo "$repo" --body "$ASC_ISSUER_ID"
gh secret list --repo "$repo"
