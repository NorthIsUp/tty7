#!/usr/bin/env bash
#MISE description="Mirror upstream into the fork's main, then merge it into main-niu (the fork's branch); FORK.md lists the hooks a conflict touches"
set -euo pipefail
git remote get-url upstream >/dev/null 2>&1 || git remote add upstream https://github.com/l0ng-ai/tty7.git
git fetch upstream main
gh repo sync NorthIsUp/tty7 --branch main --source l0ng-ai/tty7
git merge --no-edit upstream/main || { echo "conflict: resolve using the FORK.md hook table, then git commit"; exit 1; }
