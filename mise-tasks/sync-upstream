#!/usr/bin/env bash
#MISE description="Mirror upstream into the fork's main, then rebase the current branch (main-niu) onto it; FORK.md lists the hooks a conflict touches"
set -euo pipefail
git remote get-url upstream >/dev/null 2>&1 || git remote add upstream https://github.com/l0ng-ai/tty7.git
git fetch upstream main
gh repo sync NorthIsUp/tty7 --branch main --source l0ng-ai/tty7
# rerere replays a conflict resolved once before, so a repeat sync stops only on new ones.
git -c rerere.enabled=true -c rerere.autoupdate=true rebase upstream/main \
  || { echo "conflict: resolve using the FORK.md hook table, then git rebase --continue"; exit 1; }
echo "rebased; publish with: git push --force-with-lease origin HEAD"
