#!/usr/bin/env bash
#MISE description="Fold main-niu into one commit per feature, rebase it onto upstream, test, and push with a lease (docs/fork/patch-stack.md)"
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
origin=${SYNC_ORIGIN:-origin} upstream=${SYNC_UPSTREAM:-upstream} branch=${SYNC_BRANCH:-main-niu}
rr=(-c rerere.enabled=true -c rerere.autoupdate=true)

git diff --quiet && git diff --cached --quiet \
  || { echo "sync-upstream: commit or set aside your changes first" >&2; exit 1; }
git remote get-url "$upstream" >/dev/null 2>&1 || git remote add "$upstream" https://github.com/l0ng-ai/tty7.git
git fetch -q "$upstream" main
git fetch -q "$origin" "$branch"
[ -n "${SYNC_SKIP_MIRROR:-}" ] || gh repo sync NorthIsUp/tty7 --branch main --source l0ng-ai/tty7

# Whether two trees hold the same content. A feature moved up the stack takes
# its i18n keys from the end of the fork's block to its own place, so those
# files compare as sorted lines; everything else must match exactly.
same_tree() {
  local f
  git diff --quiet "$1" "$2" -- . ':!src/ui/i18n/*.rs' || return 1
  for f in $(git diff --name-only "$1" "$2" -- 'src/ui/i18n/*.rs'); do
    cmp -s <(git show "$1:$f" | LC_ALL=C sort) <(git show "$2:$f" | LC_ALL=C sort) || return 1
  done
}

# Fold BASE..HEAD into one commit per feature. Folding only regroups commits,
# so a tree that differs afterwards means a conflict was resolved wrongly.
fold() {
  local base=$1 before plan
  before=$(git rev-parse HEAD)
  plan=$(mktemp)
  "$here/fold-plan" "$base" HEAD docs/fork/stack-order.tsv ${SYNC_MAP:+"$SYNC_MAP"} > "$plan"
  git "${rr[@]}" -c sequence.editor="cp $plan" rebase -q -i "$base" \
    || { echo "sync-upstream: fold stopped on a conflict; resolve, git rebase --continue, rerun with SYNC_FROM=HEAD" >&2; exit 1; }
  same_tree "$before" HEAD \
    || { echo "sync-upstream: the fold changed the tree (compare $before with HEAD)" >&2; exit 1; }
}

# A feature upstream merged leaves a commit holding only its fork docs (its
# page, FORK.md line and stack-order row). Drop it, and take its lines out of
# the two lists the commits above it also append to.
drop_upstreamed() {
  local base=$1 before c slug f plan gone drops=()
  before=$(git rev-parse HEAD)
  for c in $(git rev-list --reverse "$base..HEAD"); do
    slug=$(git log -1 --format='%(trailers:key=Fork-Feature,valueonly)' "$c" | head -1)
    [[ -n $slug && $slug != fork-* ]] || continue
    git diff --quiet "$c^" "$c" -- . ':!FORK.md' ':!docs/fork/' || continue
    drops+=("$c"); echo "sync-upstream: upstream took $slug; dropping its fork docs"
  done
  [ ${#drops[@]} -gt 0 ] || return 0
  plan=$(mktemp) gone=$(mktemp)
  for c in $(git rev-list --reverse "$base..HEAD"); do
    [[ " ${drops[*]} " == *" $c "* ]] || echo "pick $c"
  done > "$plan"
  for c in "${drops[@]}"; do
    git diff "$c^" "$c" -- FORK.md docs/fork/stack-order.tsv | grep '^+[^+]' | cut -c2-
  done > "$gone"
  git "${rr[@]}" -c sequence.editor="cp $plan" rebase -q -i "$base" 2>/dev/null || true
  while [ -d "$(git rev-parse --git-path rebase-merge)" ]; do
    for f in $(git diff --name-only --diff-filter=U); do
      case $f in FORK.md|docs/fork/stack-order.tsv) ;; *)
        echo "sync-upstream: dropping an upstreamed feature conflicts in $f; resolve, git rebase --continue, rerun with SYNC_FROM=HEAD" >&2; exit 1;;
      esac
      { git show ":3:$f" | grep -vxFf "$gone" || true; } > "$f"; git add "$f"
    done
    GIT_EDITOR=true git "${rr[@]}" rebase --continue >/dev/null 2>&1 || true
  done
  git diff --quiet "$before" HEAD -- . ':!FORK.md' ':!docs/fork/' \
    || { echo "sync-upstream: dropping upstreamed features changed more than fork docs (compare $before with HEAD)" >&2; exit 1; }
}

lease=$(git rev-parse "$origin/$branch")
# A start other than origin's tip must hold the same tree, or a PR merged since
# it was cut would be pushed away.
[ -z "${SYNC_FROM:-}" ] || same_tree "$lease" "$SYNC_FROM" \
  || { echo "sync-upstream: $SYNC_FROM's tree differs from $origin/$branch ($lease); bring the new commits over first" >&2; exit 1; }
git switch -q --detach "${SYNC_FROM:-$lease}"
fold "$(git merge-base HEAD "$upstream/main")"
git "${rr[@]}" rebase -q --empty=drop "$upstream/main" \
  || { echo "sync-upstream: rebase stopped; keep upstream's side, re-add the hook (docs/fork/features/), git rebase --continue, rerun" >&2; exit 1; }
drop_upstreamed "$upstream/main"
run_tests() { [ -n "${SYNC_SKIP_TESTS:-}" ] || eval "${SYNC_TEST_CMD:-mise run test}"; }
run_tests

if [ -n "${SYNC_SKIP_PUSH:-}" ]; then
  echo "ready: git push --force-with-lease=$branch:$lease $origin HEAD:$branch"
  exit 0
fi
for _ in 1 2 3; do
  [ -z "${SYNC_BEFORE_PUSH:-}" ] || eval "$SYNC_BEFORE_PUSH"
  if git push -q --force-with-lease="$branch:$lease" "$origin" "HEAD:$branch"; then
    echo "pushed $branch. Branches cut from the old tip: git rebase --onto $origin/$branch $lease"
    exit 0
  fi
  git fetch -q "$origin" "$branch"
  new=$(git rev-parse "$origin/$branch")
  [ "$new" != "$lease" ] || { echo "sync-upstream: push failed, and not on the lease ($branch is unchanged)" >&2; exit 1; }
  git merge-base --is-ancestor "$lease" "$new" \
    || { echo "sync-upstream: $branch was rewritten by someone else; rerun" >&2; exit 1; }
  git "${rr[@]}" cherry-pick "$lease..$new" \
    || { echo "sync-upstream: a commit merged mid-sync conflicts; resolve, git cherry-pick --continue, rerun" >&2; exit 1; }
  fold "$(git merge-base HEAD "$upstream/main")"
  run_tests
  lease=$new
done
echo "sync-upstream: $branch kept moving; wait for a quiet minute and rerun" >&2
exit 1
